# 로컬에서는 비워 두면 .data/pglite 에 내장 Postgres(PGlite)로 저장해요.
# Vercel 에서는 Neon(Postgres) 연결 문자열을 넣어요. Vercel Marketplace 에서 Neon 을 붙이면 자동으로 들어가요.
DATABASE_URL=

# 로그인 쿠키 서명 키. 배포 환경에서는 반드시 길고 무작위인 값으로 설정해요.
# 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# 실시간 마을 (다른 사람이 움직이는 게 보이는 기능). https://liveblocks.io 대시보드의 Secret key (sk_ 로 시작)
# 비워 두면 혼자 돌아다니는 모드로 동작해요.
LIVEBLOCKS_SECRET_KEY=
